#introduction of args
def add(*args):
    total = 0
    for i in args:
        total = total + i
    print("Total:", total)

add(10, 20)

#*args = tuple form
#**kwargs = dictionary form

def additems(*args):
    print("Prices:", args)
    print("Total:", sum(args))

prices = [100, 200, 300, 400]
additems(*prices)  


