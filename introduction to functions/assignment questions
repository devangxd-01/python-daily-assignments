#Question 6
def calculate_avg(*marks):
    if not marks:
        return "No marks provided" 
    for i in marks:
        if not isinstance(i, (int, float)) or isinstance(i, bool):
            return "Invalid input: All marks should be numbers"
        if i < 0 or i > 100:
            return "Invalid input: Marks should be between 0 and 100"
    return sum(marks) / len(marks)

print(calculate_avg(55, 65, 75, 85, 95 ,True)) #all marks should be numbers
print(calculate_avg()) #no marks provided
print(calculate_avg(55, 65, 75, 85, 95)) #valid input