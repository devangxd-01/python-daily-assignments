# Pattern 1: Increasing Star Triangle
n = 5

for i in range(1, n + 1):
    for j in range(i):
        print("*", end=" ")
    print(end="\n")


# Pattern 2: Decreasing Star Triangle
n = 5

for i in range(n, 0, -1):
    for j in range(i):
        print("*", end=" ")
    print(end="\n")


# Pattern 3: Square Star Pattern
n = 4

for i in range(n):
    for j in range(n):
        print("*", end=" ")
    print(end="\n")



