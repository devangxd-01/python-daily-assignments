# Pattern 1: Alphabet Triangle
print("by Devang Bharadwaj")
n = 5

for i in range(1, n + 1):
    for j in range(0, i):
        print(chr(65 + j), end=" ")
    print(end="\n")


# Pattern 7: Continuous Number Triangle
print("by Devang Bharadwaj")
row = 5
num = 2

for i in range(1, row + 1):
    for j in range(1, i + 1):
        print(num, end=" ")
        num += 1
    print(end="\n")
