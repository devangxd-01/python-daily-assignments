# Pattern 1: Square Pattern Using While Loop

print("by Devang Bharadwaj")

num = 4
row = 1

while row <= num:
    star = 1
    
    while star <= num:
        print("*", end=" ")
        star += 1
    
    print(end="\n")
    row += 1


