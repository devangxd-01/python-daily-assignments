# 1. Check Student Result
#
# Question:
# Given a dictionary containing student marks, use a loop to print
# whether each student has Passed or Failed.
#
# Condition:
# Marks >= 40 -> Pass
# Marks < 40 -> Fail

students = {
    "Rahul": 75,
    "Amit": 32,
    "Priya": 88,
    "Neha": 39,
    "Rohit": 55
}

for name, marks in students.items():
    if marks >= 40:
        print(name, "-> Pass")
    else:
        print(name, "-> Fail")


# 2. Product Stock Management
#
# Question:
# A dictionary contains products and their available stock.
# Use a loop and nested conditions to display the stock status.
#
# Conditions:
# Stock = 0 -> Out of Stock
# Stock <= 5 -> Low Stock
# Stock > 5 -> Available


print("by sanskriti saxena ")
products = {
    "Laptop": 10,
    "Mouse": 3,
    "Keyboard": 0,
    "Monitor": 7,
    "Printer": 2
}

for product, stock in products.items():
    if stock == 0:
        print(product, "-> Out of Stock")
    else:
        if stock <= 5:
            print(product, "-> Low Stock")
        else:
            print(product, "-> Available")
