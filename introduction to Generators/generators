#introduction of yield

#without loop  
def even_numbers(start, end):
    for num in range(start, end + 1):
        if num % 2 == 0:
            yield num


i = even_numbers(1, 10)
print(next(i,"error:iteration Over"))
print(next(i,"error:iteration Over"))
print(next(i,"error:iteration Over"))
print(next(i,"error:iteration Over"))
print(next(i,"error:iteration Over"))
print(next(i,"error:iteration Over"))

#with loop
def even_numbers(start, end):
    for num in range(start, end + 1):
        if num % 2 == 0:
            yield num


for i in even_numbers(1, 10):
    print(i)


