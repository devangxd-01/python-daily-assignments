#introduction of yield and generators 
#student records
students = [
    {"name": "Alice", "marks": [20, 30, 40]},
    {"name": "Bob", "marks": [22, 32, 42]},
    {"name": "Charlie", "marks": [21, 31, 41]},
    {"name": "David", "marks": [23, 33, 43]},
    {"name": "Eve", "marks": [20, 30, 40]}
]

def generate_result(student_records):
    for student in student_records:
        name = student["name"]
        marks = student["marks"]
        total_marks = sum(marks)
        average_marks = total_marks / len(marks)
        if average_marks >= 35:
            status = "Pass"
        else:
            status = "Fail"
            
        yield {"name": name, "total_marks": total_marks, "average_marks": average_marks, "status": status}
ex = generate_result(students)
for i in ex:
    print(i)


